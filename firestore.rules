rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function verified() {
      return request.auth != null;
    }

    // ================== 🫨 SHAKE AND CHAT ==================
    // (own Firebase project: shake-and-chat-c45c8)

    match /sc_users/{uid} {
      allow read: if verified();
      allow write: if verified() && request.auth.uid == uid;
      match /friends/{other} {
        allow read, write: if verified() && request.auth.uid == uid;
      }
    }

    // Shake chesi wait chestunna vaallu
    match /sc_queue/{uid} {
      allow read: if verified();
      allow create, delete: if verified() && request.auth.uid == uid;
      // Owner, leda inko user "roomId" matrame set cheyyagalaru (match ayyinappudu)
      allow update: if verified() && (
        request.auth.uid == uid ||
        (resource.data.roomId == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roomId']))
      );
    }

    // Chat rooms: members matrame
    match /sc_rooms/{rid} {
      allow read: if verified() && (resource == null || request.auth.uid in resource.data.members);
      allow create: if verified() && request.auth.uid in request.resource.data.members;
      allow update: if verified()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;

      match /msgs/{mid} {
        allow read: if verified()
          && request.auth.uid in get(/databases/$(database)/documents/sc_rooms/$(rid)).data.members;
        allow create: if verified()
          && request.resource.data.from == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000
          && request.auth.uid in get(/databases/$(database)/documents/sc_rooms/$(rid)).data.members;
      }
    }

    // Reports: create matrame (Firebase console lo chudandi)
    match /sc_reports/{id} {
      allow create: if verified() && request.resource.data.by == request.auth.uid;
    }
  }
}
